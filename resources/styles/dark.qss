/* Dark Stylesheet for Weather App Pro */



/* =====================================================
   Global
   ===================================================== */

QWidget {
    background: #141515;
    font-family: "Segoe UI";
    font-size: 16px;
}

QSvgWidget {
    background: transparent;
}

QLabel {
    color: white;
    background: transparent;
}

QLineEdit {
    background: #252526;
    color: white;
    border: 1px solid #4A4A4A;
    border-radius: 8px;
    padding: 8px;
}

QPushButton#search_button {
    background: #2D6CDF;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 18px;
    font-weight: bold;
}


QPushButton#search_button:hover {
    background: #4C82E6;
}

QPushButton#search_button:pressed {
    background: #1F5CC0;
}

/* =====================================================
   Menu Bar
   ===================================================== */

QMenuBar {
    background: #141515;
    color: white;
}

QMenuBar::item {
    background: transparent;
    color: white;
    padding: 6px 12px;
}

QMenuBar::item:selected {
    background: #2D6CDF;
    color: white;
}

QMenu {
    background: #252526;
    color: white;
    border: 1px solid #3E3E42;
}

QMenu::item {
    padding: 8px 28px;
}

QMenu::item:selected {
    background: #2D6CDF;
    color: white;
}

/* =====================================================
   Hero Panel
   ===================================================== */

QFrame#heroPanel {
    background: #141515;
    border: 1px solid #2D3139;
    border-radius: 18px;
    padding: 18px;
}


/* =====================================================
   Details Panel
   ===================================================== */

QFrame#detailsPanel {
    background: #141515;
    border: 1px solid #2D3139;
    border-radius: 18px;
    padding: 18px;
}

/*=========================================================
    Detail Cards
=========================================================*/

#detailCard {

    background-color: #2B2B2B;
    border: 1px solid #454545;
    border-radius: 16px;
    padding: 8px;
}

QLabel#detailTitle {

    color: #BEBEBE;
    font-size: 10pt;
    font-weight: 600;
    background: transparent;

}

QLabel#detailValue {

    color: #FFFFFF;
    font-size: 10pt;
    font-weight: 700;
    background: transparent;

}


/* =====================================================
   Forecast Panel
   ===================================================== */

QFrame#forecastPanel {
    background: #141515;
    border: 1px solid #2D3139;
    border-radius: 18px;
    padding: 18px;
}

/* =====================================================
   Forecast Card
   ===================================================== */

QFrame#forecastCard {
    background: #2B2B2B;
    border: 1px solid #3E3E42;
    border-radius: 12px;
}

QFrame#forecastCard:hover {
    border: 1px solid #4C82E6;
}

/* =====================================================
   Labels
   ===================================================== */

QLabel#city_label {
    font-size: 32px;
    font-weight: bold;
    color: #F4F6F9;
}

QLabel#temperature_label {
    font-size: 42px;
    font-weight: bold;
    color: #FFFFFF;
}

QLabel#celsius_label {
    font-size: 24px;
    font-weight: bold;
}

QLabel#description_label {
    font-size: 18px;
    color: #B0B0B0;
    font-weight: 600;
}

QLabel#minmax_label {
    font-size: 15px;
    color: #B0B0B0;
}

QLabel#forecast_title {
    font-size: 20px;
    font-weight: bold;
    color: #F4F6F9;
}

QFrame#forecastCard QLabel {
    color: white;
    background: transparent;
}

QLabel#status_label,
QLabel#time_label {
    color: #B0B0B0;
}

