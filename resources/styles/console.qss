/* =====================================================
   Console Glass theme: the glass console redesign.

   The window background is painted by SkyWidget, so every
   widget here is either transparent or a dark glass panel.

   Contrast: label colors and panel opacities are verified
   against WCAG AA in tests/test_contrast.py, composited
   over every gradient stop of every condition. Keep the
   alphas in sync with that test when tuning.

   Accent colors are condition driven: WeatherApp carries a
   dynamic "condition" property and the attribute selectors
   at the bottom recolor the accent widgets to match.
   ===================================================== */

QWidget {
    background: transparent;
    font-family: "Segoe UI";
    font-size: 14px;
    color: #eef2f7;
}

QLabel {
    background: transparent;
}

/* =====================================================
   Content scroll area: stays invisible over the sky
   ===================================================== */

QScrollArea#consoleScroll {
    background: transparent;
    border: none;
}

QScrollArea#consoleScroll > QWidget > QWidget {
    background: transparent;
}

QScrollBar:vertical {
    background: rgba(11, 16, 25, 120);
    width: 10px;
    border-radius: 5px;
    margin: 3px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 60);
    border-radius: 4px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 90);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    width: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

/* =====================================================
   Menu bar
   ===================================================== */

QMenuBar {
    background: transparent;
    color: rgba(238, 242, 247, 210);
    border: none;
    padding: 2px 6px;
}

QMenuBar::item {
    background: transparent;
    border-radius: 6px;
    padding: 4px 12px;
}

QMenuBar::item:selected {
    background: rgba(255, 255, 255, 34);
}

QMenu {
    background: rgba(13, 18, 28, 244);
    color: #eef2f7;
    border: 1px solid rgba(255, 255, 255, 46);
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    background: transparent;
    border-radius: 6px;
    padding: 6px 26px 6px 16px;
}

QMenu::item:selected {
    background: rgba(255, 255, 255, 36);
}

QMenu::indicator {
    width: 12px;
    height: 12px;
    margin-left: 8px;
}

/* =====================================================
   Glass panels: dark enough for AA text over every
   condition gradient (see tests/test_contrast.py)
   ===================================================== */

QFrame#statusLine, QFrame#heroPanel, QFrame#statTile,
QFrame#forecastPanel {
    background: rgba(11, 16, 25, 170);
    border: 1px solid rgba(255, 255, 255, 38);
    border-radius: 12px;
}

QFrame#forecastRow {
    background: transparent;
    border: none;
    border-radius: 8px;
}

QFrame#forecastRow[today="true"] {
    background: rgba(255, 255, 255, 18);
}

/* Chips: the section titles and footer sit directly on
   the sky, so they carry their own dark glass backing. */

QLabel#sectionTitle, QLabel#footerLabel {
    background: rgba(11, 16, 25, 180);
    border: 1px solid rgba(255, 255, 255, 30);
    border-radius: 8px;
    padding: 6px 14px;
}

QLabel#sectionTitle {
    font-size: 10px;
    font-weight: 600;
    color: rgba(238, 242, 247, 235);
}

/* =====================================================
   Search
   ===================================================== */

QLineEdit#searchInput {
    background: rgba(11, 16, 25, 170);
    border: 1px solid rgba(255, 255, 255, 46);
    border-radius: 10px;
    padding: 12px 16px;
    font-size: 14px;
    font-family: Consolas, "Courier New", monospace;
    color: #eef2f7;
    selection-background-color: rgba(255, 255, 255, 60);
}

QLineEdit#searchInput:focus {
    border: 1px solid #6fb3ff;
}

QPushButton#searchButton {
    background: #6fb3ff;
    color: #10151d;
    font-size: 13px;
    font-weight: 800;
    border: none;
    border-radius: 10px;
    padding: 12px 26px;
}

QPushButton#searchButton:disabled {
    background: rgba(255, 255, 255, 60);
    color: rgba(16, 21, 29, 140);
}

QPushButton#searchButton:hover {
    background: #86c0ff;
}

/* =====================================================
   Status line
   ===================================================== */

QLabel#stationLabel {
    font-size: 11px;
    color: rgba(238, 242, 247, 210);
}

QLabel#localClock {
    font-size: 12px;
    font-weight: 600;
    color: rgba(238, 242, 247, 225);
    font-family: Consolas, "Courier New", monospace;
}

QLabel#localTag {
    font-size: 9px;
    font-weight: 600;
    color: rgba(238, 242, 247, 205);
}

/* Accent text lives on a darker pill so every condition
   accent passes AA against it (see tests/test_contrast.py). */

QLabel#liveBadge {
    font-size: 11px;
    font-weight: 700;
    color: #6fb3ff;
    background: rgba(4, 8, 16, 150);
    border-radius: 8px;
    padding: 4px 12px;
}

/* =====================================================
   Hero
   ===================================================== */

QLabel#heroTemp {
    font-size: 72px;
    font-weight: 300;
    font-family: Consolas, "Courier New", monospace;
}

QLabel#heroAlt {
    font-size: 26px;
    font-weight: 300;
    color: rgba(238, 242, 247, 190);
    font-family: Consolas, "Courier New", monospace;
}

QLabel#conditionText {
    font-size: 16px;
    font-weight: 700;
    color: #6fb3ff;
    background: rgba(4, 8, 16, 150);
    border-radius: 8px;
    padding: 4px 12px;
}

QLabel#heroMeta {
    font-size: 13px;
    color: rgba(238, 242, 247, 205);
    font-family: Consolas, "Courier New", monospace;
}

/* =====================================================
   Measurement tiles
   ===================================================== */

QLabel#statTitle {
    font-size: 10px;
    font-weight: 600;
    color: rgba(238, 242, 247, 205);
}

QLabel#statValue {
    font-size: 22px;
    font-weight: 500;
    font-family: Consolas, "Courier New", monospace;
}

QLabel#statUnit {
    font-size: 12px;
    color: rgba(238, 242, 247, 205);
}

/* =====================================================
   Forecast table
   ===================================================== */

QLabel#forecastDay {
    font-size: 13px;
    font-weight: 700;
}

QLabel#forecastValues {
    font-size: 15px;
    font-family: Consolas, "Courier New", monospace;
}

/* =====================================================
   Footer
   ===================================================== */

QLabel#footerLabel {
    font-size: 12px;
    color: rgba(238, 242, 247, 235);
}

/* =====================================================
   Condition accents: WeatherApp carries a dynamic
   "condition" property; these rules keep the search
   button, live badge, and condition text on palette.
   ===================================================== */

WeatherApp[condition="clear"] QPushButton#searchButton,
WeatherApp[condition="clear"] QPushButton#searchButton:hover {
    background: #ffb454;
    color: #10151d;
}
WeatherApp[condition="clear"] QLabel#liveBadge,
WeatherApp[condition="clear"] QLabel#conditionText {
    color: #ffb454;
}

WeatherApp[condition="cloudy"] QPushButton#searchButton,
WeatherApp[condition="cloudy"] QPushButton#searchButton:hover {
    background: #9db8d9;
    color: #10151d;
}
WeatherApp[condition="cloudy"] QLabel#liveBadge,
WeatherApp[condition="cloudy"] QLabel#conditionText {
    color: #9db8d9;
}

WeatherApp[condition="rain"] QPushButton#searchButton,
WeatherApp[condition="rain"] QPushButton#searchButton:hover {
    background: #6fb3ff;
    color: #10151d;
}
WeatherApp[condition="rain"] QLabel#liveBadge,
WeatherApp[condition="rain"] QLabel#conditionText {
    color: #6fb3ff;
}

WeatherApp[condition="snow"] QPushButton#searchButton,
WeatherApp[condition="snow"] QPushButton#searchButton:hover {
    background: #9fd8ff;
    color: #10151d;
}
WeatherApp[condition="snow"] QLabel#liveBadge,
WeatherApp[condition="snow"] QLabel#conditionText {
    color: #9fd8ff;
}

WeatherApp[condition="mist"] QPushButton#searchButton,
WeatherApp[condition="mist"] QPushButton#searchButton:hover {
    background: #b8c4cc;
    color: #10151d;
}
WeatherApp[condition="mist"] QLabel#liveBadge,
WeatherApp[condition="mist"] QLabel#conditionText {
    color: #b8c4cc;
}

WeatherApp[condition="night"] QPushButton#searchButton,
WeatherApp[condition="night"] QPushButton#searchButton:hover {
    background: #b48cff;
    color: #10151d;
}
WeatherApp[condition="night"] QLabel#liveBadge,
WeatherApp[condition="night"] QLabel#conditionText {
    color: #b48cff;
}
