/* Light Stylesheet for Weather App Pro */



/* =====================================================
   Global
   ===================================================== */

QWidget {
    background: #F4F6F9;
    font-family: "Segoe UI";
    font-size: 16px;
}

QLabel {
    background: transparent;
}

QSvgWidget {
    background: transparent;
}

QLineEdit {
    font-size: 18px;
    padding: 8px;
}

QPushButton#search_button {
    background: #2D6CDF;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 18px;
    font-weight: bold;
}

QPushButton#search_button:hover {
    background: #4C82E6;
}

QPushButton#search_button:pressed {
    background: #1F5CC0;
}

/* =====================================================
   Menu Bar
   ===================================================== */

QMenuBar {
    background: white;
    color: black;
}

QMenuBar::item {
    background: transparent;
    color: black;
    padding: 6px 12px;
}

QMenuBar::item:selected {
    background: #E8F0FE;
    color: black;
}

QMenu {
    background: white;
    color: black;
    border: 1px solid #D9D9D9;
}

QMenu::item {
    padding: 8px 28px;
}

QMenu::item:selected {
    background: #2D6CDF;
    color: white;
}

/* =====================================================
   Hero Panel
   ===================================================== */

QFrame#heroPanel {
    background: white;
    border: 1px solid #D9D9D9;
    border-radius: 18px;
    padding: 18px;
}

/* =====================================================
   Details Panel
   ===================================================== */

QFrame#detailsPanel {
    background: white;
    border: 1px solid #D9D9D9;
    border-radius: 18px;
    padding: 18px;
}

/*=========================================================
    Detail Cards
=========================================================*/

#detailCard {

    background-color: #FFFFFF;
    border: 1px solid #D9D9D9;
    border-radius: 16px;
    padding: 8px;
}

QLabel#detailTitle {

    color: #666666;
    font-size: 10pt;
    font-weight: 600;

}

QLabel#detailValue {

    color: #202020;
    font-size: 10pt;
    font-weight: 700;

}

/* =====================================================
   Forecast Panel
   ===================================================== */

QFrame#forecastPanel {
    background: white;
    border: 1px solid #D9D9D9;
    border-radius: 18px;
    padding: 18px;
}

/* =====================================================
   Forecast Card
   ===================================================== */

QFrame#forecastCard {
    background: white;
    border: 1px solid #D9D9D9;
    border-radius: 12px;
}

QFrame#forecastCard:hover {
    border: 1px solid #4C82E6;
}

/* =====================================================
   Labels
   ===================================================== */

QLabel#city_label {
    font-size: 32px;
    font-weight: bold;
}

QLabel#temperature_label {
    font-size: 42px;
    font-weight: bold;
}

QLabel#celsius_label {
    font-size: 24px;
    font-weight: bold;
}

QLabel#description_label {
    font-size: 18px;
    color: #555555;
    font-weight: 600;
}

QLabel#minmax_label {
    font-size: 15px;
    color: #777777;
}

QLabel#forecast_title {
    font-size: 20px;
    font-weight: bold;
}

QFrame#forecastCard QLabel {
    color: black;
    background: transparent;
}

QLabel#status_label,
QLabel#time_label {
    color: gray;
}